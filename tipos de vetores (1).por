programa {
  funcao inicio() {
    inteiro notas[5]
    real altura [10]
    cadeia nomes[3]
    logico respostas[4]

    nomes[0] = "Henrique"
    nomes[1] = "Tibe"
    nomes[2] = "Luis"
    
    escreva(nomes[0],"\n")
    escreva(nomes[1],"\n")
    escreva(nomes[2],"\n")

   respostas[0] = verdadeiro
   respostas[1] = falso
   respostas[2] = falso
   respostas[3] = verdadeiro

   escreva(respostas[0],"\n")
   escreva(respostas[1],"\n")
   escreva(respostas[2],"\n")
   escreva(respostas[3],"\n")

   notas[0] = 5
   notas[1] = 2
   notas[2] = 6
   notas[3] = 7
   notas[4] = 10

   escreva(notas[0],"\n")
   escreva(notas[1],"\n")
   escreva(notas[2],"\n")
   escreva(notas[3],"\n")
   escreva(notas[4],"\n")
   
   altura[0] = 9.7
   altura[1] = 2.1
   altura[2] = 6.7
   altura[3] = 7.7 
   altura[4] = 8.1
   altura[5] = 3.2
   altura[6] = 9.4
   altura[7] = 4.2
   altura[8] = 2.9
   altura[9] = 1.8

  escreva(altura[0],"\n")
  escreva(altura[1],"\n")
  escreva(altura[2],"\n")
  escreva(altura[3],"\n")
  escreva(altura[4],"\n")
  escreva(altura[5],"\n")
  escreva(altura[6],"\n")
  escreva(altura[7],"\n")
  escreva(altura[8],"\n")
  escreva(altura[9],"\n")
  }
}
