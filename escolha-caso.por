programa {
  funcao inicio() {
    inteiro opcao
    escreva("escolha(1-3);")
    leia(opcao)

    escolha(opcao){
      caso 1:
      escreva("Cadastrar usuario")
      pare

      caso 2:
      escreva("listar usuarios")
      pare

      caso 3:
      escreva("sair do sistema")
      pare
      
      caso contrario:
      escreva("opçâo invalida")
  }
}
}