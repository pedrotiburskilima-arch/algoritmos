programa {
  funcao inicio() {
//declaraçao da variavel (criando a "caixa")
cadeia nomeUsuario
    
//ENTRADA:capturando dados do usuario
escreva(" Digite seu nome ")
leia(nomeUsuario)

//saida:exibindo o resultado
escreva("Ola, ",nomeUsuario,"!")
  }
}